# Get this value from Clerk Dashboard > API Keys > Publishable key.
# Keep the real value in .env (which is gitignored), not in this file.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# Copy the pooled connection string from Neon Dashboard > Connect.
# This must stay server-side; do not prefix it with EXPO_PUBLIC_.
DATABASE_URL=postgresql://user:password@host.neon.tech/database?sslmode=require
